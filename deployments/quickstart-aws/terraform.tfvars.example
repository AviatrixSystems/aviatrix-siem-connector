# Aviatrix SIEM Connector — Quickstart Example
# Copy to terraform.tfvars and fill in your values, or use quickstart.sh

vpc_id     = "vpc-xxxxxxxxxxxxxxxxx"
subnet_ids = ["subnet-xxxxxxxxxxxxxxxxx", "subnet-yyyyyyyyyyyyyyyyy"]

output_type = "splunk-hec"  # splunk-hec, dynatrace, zabbix, etc.

# SIEM-specific variables
logstash_config_variables = {
  SPLUNK_ADDRESS  = "https://your-splunk-server"
  SPLUNK_HEC_AUTH = "your-hec-token"
}

# Who may send syslog (the NLB preserves client IPs). Default ["0.0.0.0/0"];
# restrict to your Aviatrix gateway/controller egress IPs.
# allowed_syslog_cidrs = ["203.0.113.10/32"]

# Pin a release tag: a mutable "latest" never changes the task definition, so
# new images would not roll out on re-apply.
# image_tag = "v1.0.0"
