FROM docker.elastic.co/logstash/logstash:9.5.7
LABEL org.opencontainers.image.source="https://github.com/AviatrixSystems/aviatrix-siem-connector"
LABEL org.opencontainers.image.description="Aviatrix SIEM Connector - Logstash ETL pipeline"

# Install all output plugins that aren't bundled with Logstash.
# For reproducible builds, pin the plugin versions with build args, e.g.
#   --build-arg ZABBIX_PLUGIN_VERSION=<ver> --build-arg SENTINEL_PLUGIN_VERSION=<ver>
# Empty means "latest at build time".
ARG ZABBIX_PLUGIN_VERSION=""
ARG SENTINEL_PLUGIN_VERSION=""
RUN set -e; \
    install_plugin() { \
      if [ -n "$2" ]; then logstash-plugin install --version "$2" "$1"; \
      else logstash-plugin install "$1"; fi; \
    }; \
    install_plugin logstash-output-zabbix "$ZABBIX_PLUGIN_VERSION"; \
    install_plugin microsoft-sentinel-log-analytics-logstash-output-plugin "$SENTINEL_PLUGIN_VERSION"

# Bake all assembled configs, custom grok patterns and the entrypoint.
# Copied without --chmod: BuildKit applies --chmod to created directories too,
# which made /opt/configs (mode 644) untraversable for the logstash user.
USER root
COPY configs/ /opt/configs/
COPY patterns/ /usr/share/logstash/patterns/
# OUTPUT_TYPE selection; hands off to the stock /usr/local/bin/docker-entrypoint
# (env2yaml) and passes container args through to Logstash.
COPY entrypoint.sh /entrypoint.sh
RUN chmod -R a+rX,go-w /opt/configs /usr/share/logstash/patterns \
 && chmod 755 /entrypoint.sh
USER 1000

ENTRYPOINT ["/entrypoint.sh"]
